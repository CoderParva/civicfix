# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-only-local-key-change-me-0123456789abcdef
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# postgis:// scheme selects the PostGIS backend
DATABASE_URL=postgis://civicfix:civicfix@db:5432/civicfix
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Used by the docker-compose db service
POSTGRES_DB=civicfix
POSTGRES_USER=civicfix
POSTGRES_PASSWORD=civicfix

# AI helpers (development only). "local" = real models if installed via scripts/install-ai-libs.sh;
# "disabled" = no models, exactly how production behaves. Production settings force "disabled".
AI_INFERENCE=local
