# Set these in Cloudflare Pages > Settings > Environment variables (Production). Vite bakes them in at BUILD time,
# so changing one means triggering a new deployment.
VITE_API_URL=https://civicfix-api.onrender.com/api/v1
# Optional: only if you host your own map style. The default (OpenFreeMap) needs no key and allows any origin.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
